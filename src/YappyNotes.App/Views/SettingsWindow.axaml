<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:YappyNotes.App"
        xmlns:vm="clr-namespace:YappyNotes.ViewModels;assembly=YappyNotes.ViewModels"
        x:Class="YappyNotes.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="YappyNotes settings"
        Icon="/Assets/yappynotes.png"
        Width="360" Height="410"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="18">

        <StackPanel Spacing="6">
            <TextBlock Text="New notes are" FontWeight="SemiBold" />
            <ComboBox x:Name="ColorBox"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableColors}"
                      SelectedItem="{Binding DefaultNoteColor}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="16" Height="16" CornerRadius="3"
                                    BorderBrush="#33000000" BorderThickness="1"
                                    Background="{Binding Converter={x:Static app:NoteBrushes.Paper}}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Theme" FontWeight="SemiBold" />
            <ComboBox x:Name="ThemeBox"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableThemes}"
                      SelectedItem="{Binding Theme}" />
            <TextBlock Text="Notes are always light paper. This is the manager window."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
            <CheckBox x:Name="StartAtLoginBox"
                      Content="Start YappyNotes when I log in"
                      IsChecked="{Binding StartAtLogin}"
                      IsEnabled="{Binding CanChooseStartAtLogin}" />
            <TextBlock Text="Your notes are back on the desktop after a restart. Only an installed copy can start at login."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
            <CheckBox x:Name="UpdatesBox"
                      Content="Check for updates when YappyNotes starts"
                      IsChecked="{Binding CheckForUpdates}" />
            <TextBlock Text="Asks GitHub whether a newer release exists. Nothing about your notes is sent."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="Changes are saved as you make them."
                   FontSize="11" Opacity="0.55"
                   VerticalAlignment="Bottom" />
    </StackPanel>
</Window>
