<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:YappyNotes.App"
        xmlns:vm="clr-namespace:YappyNotes.ViewModels;assembly=YappyNotes.ViewModels"
        xmlns:core="clr-namespace:YappyNotes.Core;assembly=YappyNotes.Core"
        xmlns:views="clr-namespace:YappyNotes.App.Views"
        x:Class="YappyNotes.App.Views.NoteWindow"
        x:DataType="vm:NoteViewModel"
        Title="{Binding Title}"
        Width="280" Height="300"
        MinWidth="180" MinHeight="140"
        RequestedThemeVariant="Light"
        WindowDecorations="None"
        Topmost="{Binding IsAlwaysOnTop}"
        ShowInTaskbar="False"
        Background="{Binding Color, Converter={x:Static app:NoteBrushes.Paper}}">

    <!-- Fluent draws a TextBox as a filled, bordered form field, which is the
         opposite of what a sticky note is: setting Background="Transparent" on
         the control alone does nothing, because the template's own border
         element carries the fill and swaps it again on hover and focus. These
         reach into that element for every state. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+P" Command="{Binding TogglePinCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding AddTimerCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CaretBrush" Value="#333333" />
            <Setter Property="SelectionBrush" Value="#66000000" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>

        <!-- Same for the two header buttons: they should read as marks on the
             paper, not as chrome sitting on top of it. -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22000000" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33000000" />
        </Style>

        <!-- The timer's transport: one size of key, one size of icon. The icons are
             drawn rather than typed, because a glyph brings its own width and
             baseline - and on a platform whose font lacks it, a fallback font's -
             so pause, restart, stop and the settings dots came out four sizes.
             Each shape is drawn in the same 10 by 10 box and not stretched, so a
             square and a triangle keep their relative weight. -->
        <Style Selector="Button.transport">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.transport > Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Fill" Value="#333333" />
        </Style>
        <Style Selector="Button.transport:disabled > Path">
            <Setter Property="Fill" Value="#80333333" />
        </Style>
    </Window.Styles>

    <Border x:Name="NoteChrome" BorderThickness="1">
    <Border.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Yellow" Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:NoteColor.Yellow}" />
            <MenuItem Header="Green"  Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:NoteColor.Green}" />
            <MenuItem Header="Blue"   Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:NoteColor.Blue}" />
            <MenuItem Header="Pink"   Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:NoteColor.Pink}" />
            <MenuItem Header="Purple" Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:NoteColor.Purple}" />
            <MenuItem Header="Grey"   Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:NoteColor.Grey}" />
            <Separator />
            <MenuItem Header="Keep on top" Command="{Binding TogglePinCommand}" />
            <MenuItem Header="Add a timer" Command="{Binding AddTimerCommand}" IsVisible="{Binding !HasTimer}" />
            <MenuItem Header="Remove the timer" Command="{Binding RemoveTimerCommand}" IsVisible="{Binding HasTimer}" />
            <MenuItem Header="Archive" Command="{Binding ArchiveCommand}" />
        </ContextMenu>
    </Border.ContextMenu>
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- The drag handle. A borderless window has no title bar to grab, so
             this strip is it; NoteWindow.axaml.cs calls BeginMoveDrag. -->
        <Grid x:Name="Header"
              Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              Background="{Binding Color, Converter={x:Static app:NoteBrushes.Edge}}">

            <!-- Not hit-testable until you double-click it. A TextBox fills its
                 whole cell and marks a press handled for caret placement, so
                 while it is in the way there is nowhere on this strip left to
                 grab the window by - which is exactly the bug this replaced.
                 NoteWindow.axaml.cs turns it back on to edit. -->
            <TextBox Grid.Column="0"
                     x:Name="TitleBox"
                     Text="{Binding Title}"
                     PlaceholderText="Title"
                     IsHitTestVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#222"
                     FontWeight="SemiBold"
                     Padding="8,4"
                     VerticalAlignment="Center" />

            <!-- The colours were only in the context menu, and right-clicking the
                 body opens the text box's own Cut/Copy/Paste menu instead, so
                 they were hard to find. The dot is painted the note's colour, which
                 says what the button is for without a word. -->
            <Button Grid.Column="1"
                    x:Name="ColorButton"
                    ToolTip.Tip="Change this note's colour"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4">
                <Ellipse Width="12" Height="12"
                         Fill="{Binding Color, Converter={x:Static app:NoteBrushes.Paper}}"
                         Stroke="#555"
                         StrokeThickness="1" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <!-- Bound to the note's colour both ways: the selection is
                             the mark on the current colour, and picking one is
                             the whole of recolouring. The flyout stays open and the
                             note repaints behind it, so a colour can be tried and
                             another picked. -->
                        <ListBox x:Name="ColorSwatches"
                                 ItemsSource="{Binding AvailableColors}"
                                 SelectedItem="{Binding Color}"
                                 Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="3" />
                                    <Setter Property="CornerRadius" Value="14" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="core:NoteColor">
                                    <Ellipse Width="22" Height="22"
                                             ToolTip.Tip="{Binding}"
                                             Fill="{Binding Converter={x:Static app:NoteBrushes.Paper}}"
                                             Stroke="#66000000"
                                             StrokeThickness="1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <ToggleButton Grid.Column="2"
                    x:Name="PinButton"
                    IsChecked="{Binding IsAlwaysOnTop}"
                    ToolTip.Tip="Keep this note on top of other windows (Ctrl+P)"
                    Content="&#x25C9;"
                    Foreground="#555"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4" />

            <Button Grid.Column="3"
                    x:Name="ArchiveButton"
                    Command="{Binding ArchiveCommand}"
                    ToolTip.Tip="Archive this note (it can be restored)"
                    Content="&#x2715;"
                    Foreground="#555"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4" />

            <Button Grid.Column="4"
                    x:Name="CloseButton"
                    Click="OnCloseClicked"
                    ToolTip.Tip="Close the window, keep the note (Ctrl+W or Esc)"
                    Content="&#x2013;"
                    Foreground="#555"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4" />
        </Grid>

        <!-- The bar stays to the count and its transport. Everything you set
             rather than press lives in a flyout, because a note is 280 pixels
             wide by default and a label, a direction toggle, four presets and a
             minutes-and-seconds pair cannot share a line with it - they were
             clipped to unreadable stumps when they tried. A flyout is not bound
             by the note's width, so it fits at any size. -->
        <Border Grid.Row="1"
                x:Name="TimerBar"
                IsVisible="{Binding HasTimer}"
                Padding="8,6"
                BorderBrush="#22000000"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  DataContext="{Binding Timer}">

                <TextBlock Grid.Row="0" Grid.Column="0"
                           x:Name="TimerLabel"
                           Text="{Binding Label}"
                           Foreground="#1A1A1A"
                           Opacity="0.65"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Bottom" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           x:Name="TimerDisplay"
                           Text="{Binding Display}"
                           Foreground="{Binding HasFinished, Converter={x:Static app:FinishedBrush.Instance}}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top" />

                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">

                    <Button x:Name="TimerStart"
                            Classes="transport"
                            ToolTip.Tip="Start"
                            IsVisible="{Binding !IsRunning}"
                            Command="{Binding StartCommand}">
                        <Path Data="M 2,0 L 10,5 L 2,10 Z" />
                    </Button>

                    <Button x:Name="TimerPause"
                            Classes="transport"
                            ToolTip.Tip="Pause"
                            IsVisible="{Binding IsRunning}"
                            Command="{Binding PauseCommand}">
                        <Path Data="M 1.5,0 H 4 V 10 H 1.5 Z M 6,0 H 8.5 V 10 H 6 Z" />
                    </Button>

                    <Button x:Name="TimerRestart"
                            Classes="transport"
                            ToolTip.Tip="Start again from the top"
                            Command="{Binding RestartCommand}">
                        <Path Data="M 5,1 A 4,4 0 1 1 1.54,3 L 2.84,3.75 A 2.5,2.5 0 1 0 5,2.5 Z M 4.2,-0.9 L 7.2,1.75 L 4.2,4.4 Z" />
                    </Button>

                    <Button x:Name="TimerReset"
                            Classes="transport"
                            ToolTip.Tip="Stop and put it back to the top"
                            Command="{Binding ResetCommand}">
                        <Path Data="M 1,1 H 9 V 9 H 1 Z" />
                    </Button>

                    <Button x:Name="TimerSettingsButton"
                            Classes="transport"
                            ToolTip.Tip="Set the label, length and direction"
                            IsEnabled="{Binding CanEdit}">
                        <Path Data="M 0,5 A 1.2,1.2 0 1 0 2.4,5 A 1.2,1.2 0 1 0 0,5 Z M 3.8,5 A 1.2,1.2 0 1 0 6.2,5 A 1.2,1.2 0 1 0 3.8,5 Z M 7.6,5 A 1.2,1.2 0 1 0 10,5 A 1.2,1.2 0 1 0 7.6,5 Z" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel x:Name="TimerSettings" Width="268" Spacing="10">

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Label" FontWeight="SemiBold" FontSize="11" />
                                        <TextBox x:Name="TimerLabelBox"
                                                 Text="{Binding Label}"
                                                 PlaceholderText="Back in"
                                                 FontSize="12" />
                                    </StackPanel>

                                    <Button x:Name="TimerDirectionToggle"
                                            Command="{Binding ToggleDirectionCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            FontSize="11"
                                            Content="{Binding IsCountingDown, Converter={x:Static app:DirectionLabel.Instance}}" />

                                    <StackPanel x:Name="TimerLengthSection"
                                                Spacing="5"
                                                IsVisible="{Binding IsCountingDown}">
                                        <TextBlock Text="How long" FontWeight="SemiBold" FontSize="11" />

                                        <ItemsControl ItemsSource="{Binding DurationPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:Int32">
                                                    <Button Margin="0,0,3,0"
                                                            FontSize="11"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Content="{Binding}"
                                                            ToolTip.Tip="Minutes"
                                                            Command="{Binding $parent[ItemsControl].((vm:NoteTimerViewModel)DataContext).SetDurationCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <NumericUpDown Grid.Column="0"
                                                           x:Name="TimerMinutes"
                                                           Value="{Binding DurationMinutes}"
                                                           ToolTip.Tip="Minutes"
                                                           Minimum="0" Maximum="600" Increment="1"
                                                           FormatString="0"
                                                           FontSize="12"
                                                           ShowButtonSpinner="True" />

                                            <TextBlock Grid.Column="1"
                                                       Text=":"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0" />

                                            <NumericUpDown Grid.Column="2"
                                                           x:Name="TimerSeconds"
                                                           Value="{Binding DurationSeconds}"
                                                           ToolTip.Tip="Seconds"
                                                           Minimum="0" Maximum="59" Increment="5"
                                                           FormatString="00"
                                                           FontSize="12"
                                                           ShowButtonSpinner="True" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The note at rest: its Markdown drawn formatted. A press on it either
             does something (a box, a link) or opens the editor below with the
             caret where the press landed. -->
        <!-- A press on a line is answered by the formatted note; a press anywhere
             else on this paper - below a short note, in the padding - reaches the
             scroll viewer and opens the editor at the end. Transparent rather than
             unset, or those presses would fall through to nothing. -->
        <ScrollViewer Grid.Row="2"
                      x:Name="FormattedScroll"
                      IsVisible="{Binding !ShowsEditor}"
                      Background="Transparent"
                      Padding="8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <views:FormattedNote x:Name="Formatted"
                                 Lines="{Binding Lines}"
                                 VerticalAlignment="Top"
                                 TextElement.Foreground="#1a1a1a" />
        </ScrollViewer>

        <TextBox Grid.Row="2"
                 x:Name="Body"
                 IsVisible="{Binding ShowsEditor}"
                 Text="{Binding Content}"
                 PlaceholderText="Write something…"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="#1a1a1a"
                 Padding="8"
                 VerticalAlignment="Stretch" />

        <!-- While editing, the Markdown editor draws plain text and a link in it
             cannot be clicked, so the links are offered here instead. Formatted,
             they are clickable where they are written, and this stays hidden.
             Only allow-listed schemes ever reach here. -->
        <ItemsControl Grid.Row="3"
                      x:Name="LinkBar"
                      IsVisible="{Binding ShowsLinkBar}"
                      ItemsSource="{Binding Links}"
                      Margin="6,0,22,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:LinkSpan">
                    <Button Margin="2"
                            Padding="6,2"
                            FontSize="11"
                            Foreground="#1A3E8C"
                            Content="{Binding Uri.Host}"
                            ToolTip.Tip="{Binding Uri}"
                            Command="{Binding $parent[ItemsControl].((vm:NoteViewModel)DataContext).OpenLinkCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- WindowDecorations="None" means the OS draws no frame and therefore
             no resize handles either. This corner is the only way to resize a
             note, so it stays on top of the body text. -->
        <Panel Grid.Row="3"
               x:Name="ResizeGrip"
               Width="16" Height="16"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Background="Transparent"
               Cursor="BottomRightCorner">
            <Path Data="M 11,15 L 15,11 M 6,15 L 15,6 M 1,15 L 15,1"
                  Stroke="#70000000"
                  StrokeThickness="1" />
        </Panel>
    </Grid>
    </Border>
</Window>
