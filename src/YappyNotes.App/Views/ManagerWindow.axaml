<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:YappyNotes.App"
        xmlns:vm="clr-namespace:YappyNotes.ViewModels;assembly=YappyNotes.ViewModels"
        x:Class="YappyNotes.App.Views.ManagerWindow"
        x:DataType="vm:ManagerViewModel"
        Title="YappyNotes"
        Icon="/Assets/yappynotes.png"
        Width="380" Height="560"
        MinWidth="320" MinHeight="360">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewNoteCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <!-- Everything you can do that is not about one particular note. -->
        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="10">

            <Button x:Name="NewNoteButton"
                    Command="{Binding NewNoteCommand}"
                    Content="New note"
                    ToolTip.Tip="Ctrl+N"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12,9" />

            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText}"
                     PlaceholderText="Search notes…"
                     Padding="8,6" />

            <Grid ColumnDefinitions="*,Auto,Auto">
                <ToggleSwitch Grid.Column="0"
                              x:Name="ArchiveToggle"
                              IsChecked="{Binding ShowingArchive}"
                              OnContent="Archive"
                              OffContent="Desktop" />

                <!-- Every open to-do from every note, instead of the notes. -->
                <ToggleButton Grid.Column="1"
                              x:Name="TodosToggle"
                              IsChecked="{Binding ShowingTodos}"
                              Content="To-dos"
                              ToolTip.Tip="Every open to-do, from every note"
                              Padding="10,4"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        x:Name="SettingsButton"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings"
                        Content="&#x2699;"
                        FontSize="15"
                        Padding="8,4"
                        VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- Which build you are looking at, and how much is in it. Docked before
             the empty message so it stays at the very bottom. -->
        <Border DockPanel.Dock="Bottom"
                x:Name="StatusBar"
                Padding="16,6"
                BorderThickness="0,1,0,0"
                BorderBrush="#22808080">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusCount"
                           FontSize="11"
                           Opacity="0.55"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           x:Name="StatusVersion"
                           FontSize="11"
                           Opacity="0.55"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="16,8,16,14"
                   Text="{Binding EmptyMessage}"
                   IsVisible="{Binding IsEmpty}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Opacity="0.5" />

        <!-- The to-do view: each note's open to-dos on a scrap of its paper.
             Ticking a box goes through the view-model to the window manager, so a
             note open on the desktop is changed through its own window. -->
        <ScrollViewer DockPanel.Dock="Top"
                      IsVisible="{Binding ShowingTodos}"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TodoList"
                          Margin="8,0,8,0"
                          ItemsSource="{Binding TodoGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TodoGroup">
                        <!-- Light, like a note row: pastel paper under the app's dark
                             variant draws pale text nobody can read. -->
                        <ThemeVariantScope RequestedThemeVariant="Light">
                            <Border Margin="0,3"
                                    Padding="10,6,10,8"
                                    CornerRadius="4"
                                    Background="{Binding Color, Converter={x:Static app:NoteBrushes.Paper}}"
                                    BorderBrush="#22000000"
                                    BorderThickness="1">
                                <StackPanel Spacing="1">
                                    <Button Content="{Binding Title}"
                                            ToolTip.Tip="Open this note"
                                            FontWeight="SemiBold"
                                            Foreground="#1A1A1A"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0,2"
                                            Command="{Binding $parent[Window].((vm:ManagerViewModel)DataContext).OpenTodoNoteCommand}"
                                            CommandParameter="{Binding}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TodoEntry">
                                                <DockPanel Margin="{Binding Level, Converter={x:Static app:IndentMargin.Instance}}">
                                                    <TextBlock x:Name="TodoDue"
                                                               DockPanel.Dock="Right"
                                                               Text="{Binding DueText}"
                                                               Foreground="{Binding DueState, Converter={x:Static app:DueBrushes.Instance}}"
                                                               FontSize="11"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <CheckBox Content="{Binding Text}"
                                                              Foreground="#1A1A1A"
                                                              FontSize="13"
                                                              MinHeight="26"
                                                              Command="{Binding $parent[Window].((vm:ManagerViewModel)DataContext).TickTodoCommand}"
                                                              CommandParameter="{Binding}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </ThemeVariantScope>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ListBox x:Name="NoteList"
                 IsVisible="{Binding !ShowingTodos}"
                 Margin="8,0,8,0"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NoteListItem">

                    <!-- A row is a scrap of the same light paper the note itself
                         is, whatever theme the manager is in. Without this scope
                         the buttons inside take the app's variant and render pale
                         text on a pastel background - invisible in dark mode,
                         which is exactly what happened. Note windows avoid it by
                         pinning the same variant on themselves. -->
                    <ThemeVariantScope RequestedThemeVariant="Light">
                    <Border Margin="0,3"
                            Padding="10,8"
                            CornerRadius="4"
                            Background="{Binding Color, Converter={x:Static app:NoteBrushes.Paper}}"
                            BorderBrush="#22000000"
                            BorderThickness="1">

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                            <DockPanel Grid.Row="0" Grid.Column="0">
                                <!-- "2/5": a checklist's state without opening the note. -->
                                <TextBlock x:Name="RowTodoProgress"
                                           DockPanel.Dock="Right"
                                           Text="{Binding TodoProgress}"
                                           IsVisible="{Binding TodoProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="#1A1A1A"
                                           Opacity="0.6"
                                           FontSize="11"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayTitle}"
                                           Foreground="#1A1A1A"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Preview}"
                                       Foreground="#1A1A1A"
                                       Opacity="0.6"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- The per-row actions. Which ones apply depends on
                                 whether the note is on the desktop or filed away,
                                 so each binds its visibility to that. -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="2">

                                <Button Content="Open"
                                        FontSize="11"
                                        Padding="7,3"
                                        IsVisible="{Binding !IsArchived}"
                                        Command="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).OpenCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Content="Archive"
                                        FontSize="11"
                                        Padding="7,3"
                                        IsVisible="{Binding !IsArchived}"
                                        Command="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).ArchiveCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Content="Restore"
                                        FontSize="11"
                                        Padding="7,3"
                                        IsVisible="{Binding IsArchived}"
                                        Command="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).RestoreCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Content="Delete"
                                        FontSize="11"
                                        Padding="7,3"
                                        Foreground="#A11"
                                        IsVisible="{Binding IsArchived}"
                                        Command="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).DeleteForeverCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    </ThemeVariantScope>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
