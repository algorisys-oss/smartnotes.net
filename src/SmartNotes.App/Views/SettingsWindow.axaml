<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SmartNotes.App"
        xmlns:vm="clr-namespace:SmartNotes.ViewModels;assembly=SmartNotes.ViewModels"
        x:Class="SmartNotes.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="SmartNotes settings"
        Width="360" Height="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="18">

        <StackPanel Spacing="6">
            <TextBlock Text="New notes are" FontWeight="SemiBold" />
            <ComboBox x:Name="ColorBox"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableColors}"
                      SelectedItem="{Binding DefaultNoteColor}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="16" Height="16" CornerRadius="3"
                                    BorderBrush="#33000000" BorderThickness="1"
                                    Background="{Binding Converter={x:Static app:NoteBrushes.Paper}}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Theme" FontWeight="SemiBold" />
            <ComboBox x:Name="ThemeBox"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableThemes}"
                      SelectedItem="{Binding Theme}" />
            <TextBlock Text="Notes are always light paper. This is the manager window."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="Changes are saved as you make them."
                   FontSize="11" Opacity="0.55"
                   VerticalAlignment="Bottom" />
    </StackPanel>
</Window>
