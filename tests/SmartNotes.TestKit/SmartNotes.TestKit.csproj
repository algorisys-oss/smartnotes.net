<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Shared test material, not a test project: it has no runner and `dotnet test`
    does not look at it.

    It holds the in-memory INoteRepository and the contract every implementation
    of that interface must satisfy. Both live here rather than in Core.Tests
    because Data.Tests runs the same contract against SQLite - that is the whole
    point of them, since a fake nobody checks against the real thing is a fake
    that quietly stops telling the truth.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartNotes.Core\SmartNotes.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
