# Neither of these is needed to run YappyNotes. Both exist for trying things
# without touching your real notes or publishing a release.

# Keep the notes database here instead of the platform's usual folder.
# scripts/dev-start.sh --sandbox sets this for you.
YAPPYNOTES_DATA_DIR=/path/to/a/throwaway/folder

# Update from a folder of Velopack releases instead of GitHub, so an update can
# be tried end to end on one machine: point it at the output of
# scripts/package-installer.sh built with a higher version, and run an older
# installed copy.
YAPPYNOTES_UPDATE_SOURCE=/path/to/artifacts/installers/linux-x64
